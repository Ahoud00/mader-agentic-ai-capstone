import streamlit as st
import os
import json
import base64
from agent import compile_and_run_graph

# 1. إعداد الصفحة وتأصيل نمط الخلفية السائلة المتداخلة والتصميم الحر (Borderless Liquid Neon UI)
st.set_page_config(page_title="REFEEQ | Real Graph Workflow", page_icon="🤖", layout="centered")

# دالة ذكية لتحويل الصورة المحلية إلى كود نصي مشفر لحقنها قسرياً داخل المتصفح
def get_base64_image(image_path):
    if os.path.exists(image_path):
        with open(image_path, "rb") as img_file:
            return base64.b64encode(img_file.read()).decode()
    return None

st.markdown("""
    <style>
    /* 1. بناء خلفية سائلة فخمة متداخلة الألوان لتعطي روقان مذهل */
    .stApp, body, [data-testid="stSidebar"], [data-testid="stSidebarNav"] {
        background: linear-gradient(135deg, #040306 0%, #0A0714 45%, #050716 85%, #020204 100%) !important;
        color: #E2E2E8 !important;
        background-attachment: fixed !important;
    }
    
    /* 2. تنظيف حقل المحادثة السفلية ليكون بالأسود المطفي المنسق بالكامل وبدون خطوط رمادية */
    div[data-testid="stChatMessageContainer"], 
    .stChatInputContainer, 
    div[data-testid="stChatInput"],
    [data-testid="stForm"],
    .stChatInputContainer textarea {
        background-color: #0A0A0F !important;
        background: #0A0A0F !important;
        border: 1px solid rgba(255, 215, 0, 0.15) !important;
        box-shadow: none !important;
        border-radius: 20px !important;
    }
    
    /* 3. تنسيق الخطوط والنصوص لتظهر بوضوح تام ونعومة فائقة فوق السواد */
    .stChatInputContainer textarea, 
    div[data-testid="stChatMessage"] p, 
    .stMarkdown,
    div[data-testid="stChatInput"] textarea, p, span, label {
        color: #E2E2E8 !important;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
    }
    
    /* 4. تصميم العناوين بشكل حر ونقي تماماً بتوهج ذهبي نيون ناعم */
    h1, h2, h3, .stTitle, [data-testid="stMetricLabel"] {
        color: #FFD700 !important;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        font-weight: 300 !important;
        text-shadow: 0 0 15px rgba(255, 215, 0, 0.3) !important;
    }
    
    /* 5. دمج صورتكِ ثلاثية الأبعاد بشكل حر تماماً وبدون أي إطار لتبدو عائمة بنقاء */
    .floating-dashboard-img {
        display: block;
        margin-left: auto;
        margin-right: auto;
        width: 100%;
        max-width: 550px;
        border-radius: 12px !important;
        mix-blend-mode: lighten !important; /* دمج مثالي مع السواد الخلفي لتبدو عائمة */
        box-shadow: 0 0 30px rgba(255, 215, 0, 0.1) !important;
    }
    
    /* 6. إزالة كافة الإطارات والمربعات الصندوقية لتكون العناصر حرة وعائمة */
    .stChatMessage, .stAlert, div[data-testid="stVerticalBlock"] > div {
        background-color: transparent !important;
        border: none !important;
        box-shadow: none !important;
        padding: 8px 0px !important;
    }
    
    /* 7. شريط تتبع عقد الـ Graph العلوي عائم وحر بنصوص بيضاء مضيئة ناعمة */
    .graph-node-free {
        text-align: center;
        font-size: 0.95rem;
        color: #FFD700;
        font-weight: bold;
        padding: 10px !important;
        text-shadow: 0 0 8px rgba(255, 215, 0, 0.3);
    }
    
    /* 8. تخصيص أزرار الدخول والتفاعل لتكون مسطحة وعائمة ومريحة */
    div.stButton > button {
        background-color: transparent !important;
        color: #FFD700 !important;
        border: 1px solid rgba(255, 215, 0, 0.4) !important;
        border-radius: 24px !important; 
        font-size: 1rem !important;
        padding: 8px 32px !important;
        transition: all 0.3s ease !important;
    }
    div.stButton > button:hover {
        background-color: #FFD700 !important;
        color: #040306 !important;
        box-shadow: 0 0 20px rgba(255, 215, 0, 0.5) !important;
        border: 1px solid #FFD700 !important;
    }
    </style>
""", unsafe_allow_html=True)

# إدارة حالة التنقل والصفحات
if "page" not in st.session_state:
    st.session_state.page = "LANDING"

# ==========================================
# 🌌 الشاشة الأولى: صفحة الهبوط الترحيبية بصورتكِ الذهبية الفخمة
# ==========================================
if st.session_state.page == "LANDING":
    st.markdown("<br><h1 style='text-align: center; font-size: 3.5rem;'>REFEEQ</h1>", unsafe_allow_html=True)
    st.markdown("<p style='text-align: center; font-size: 1.1rem; color: #888; font-weight: 300;'>INTEGRATED AGENTIC GRAPH WORKFLOW</p>", unsafe_allow_html=True)
    
    # فحص اسم الملف بدقة ليدعم الصيغتين (dashbord.png أو dashboard.png)
    img_name = "dashbord.png" if os.path.exists("dashbord.png") else "dashboard.png"
    img_base64 = get_base64_image(img_name)
    
    if img_base64:
        st.markdown(f'<img src="data:image/png;base64,{img_base64}" class="floating-dashboard-img">', unsafe_allow_html=True)
    else:
        st.warning("⏳ يرجى التأكد من وجود ملف الصورة داخل مجلد الـ VS Code باسم dashbord.png أو dashboard.png")
        
    st.markdown("<p style='text-align: center; color: rgba(255,215,0,0.4); font-size: 0.8rem; letter-spacing: 2px;'>SYSTEM ARCHITECTURE INITIALIZED</p>", unsafe_allow_html=True)
    st.markdown("<br>", unsafe_allow_html=True)
    
    col_btn_center, _ = st.columns(2)
    with col_btn_center:
        if st.button("🚀 Enter Workspace", use_container_width=True):
            st.session_state.page = "APPLICATION"
            st.rerun()

# ==========================================
# ⚙️ الشاشة الثانية: شاشة الاستعمال والـ Graph (Borderless App)
# ==========================================
elif st.session_state.page == "APPLICATION":
    with st.sidebar:
        st.markdown("<h2 style='text-align: center; font-weight: 200;'>📊 INTEG. DASHBOARD</h2>", unsafe_allow_html=True)
        st.markdown("---")
        st.metric(label="💰 ميزانية استهلاك الوكيل", value="$5.00 / Daily Max")
        st.metric(label="🧠 قاعدة تقليص الذاكرة", value="4000 Tokens")
        st.markdown("---")
        if st.button("⬅️ العودة للرئيسية", use_container_width=True):
            st.session_state.page = "LANDING"
            st.rerun()

    st.markdown("<h1 style='text-align: center; font-weight: 200;'>REFEEQ | بوابتك التنفيذية</h1>", unsafe_allow_html=True)
    st.caption("<p style='text-align: center; color: #888;'>أرسل أوامرك لـ 'مدار' لمسح مستنداتك أو تفعيل تنبيهات بروتوكول MCP</p>", unsafe_allow_html=True)
    st.markdown("---")

    col_n1, col_n2, col_n3 = st.columns(3)
    with col_n1:
        st.markdown("<div class='graph-node-free'>🛡️ Node 1:<br>Security Guard</div>", unsafe_allow_html=True)
    with col_n2:
        st.markdown("<div class='graph-node-free'>🧠 Node 2:<br>Reasoning Loop</div>", unsafe_allow_html=True)
    with col_n3:
        st.markdown("<div class='graph-node-free'>⚙️ Node 3:<br>Execution Hub</div>", unsafe_allow_html=True)
    st.markdown("---")

    if "messages" not in st.session_state:
        st.session_state.messages = []
    if "pending_alert" not in st.session_state:
        st.session_state.pending_alert = None

    for message in st.session_state.messages:
        with st.chat_message(message["role"]):
            st.markdown(message["content"])

    if user_query := st.chat_input("بماذا يمكنني مساعدتك اليوم في جدولك ومهامك؟"):
        st.session_state.messages.append({"role": "user", "content": user_query})
        with st.chat_message("user"):
            st.markdown(user_query)
            
        with st.spinner("⛓️ جاري تمرير الطلب عبر الـ Graph Nodes..."):
            status, response_content = compile_and_run_graph(user_query)
            
            if status == "HUMAN_APPROVAL_REQUIRED":
                st.session_state.pending_alert = response_content
                st.rerun()
            else:
                st.session_state.messages.append({"role": "assistant", "content": response_content})
                with st.chat_message("assistant"):
                    st.markdown(response_content)

    if st.session_state.pending_alert:
        st.warning("⛓️ *[Graph Node: Human Approval Gate]* تم تعليق مسار المخطط بانتظار موافقتك البشرية لإجراء الـ MCP.")
        st.info(f"📝 *المحتوى المراد تمريره للنقطة التالية:* {st.session_state.pending_alert}")
        
        col1, col2 = st.columns(2)
        with col1:
            if st.button("✅ موافقة وتمرير في الـ Graph", use_container_width=True):
                success_msg = f"🚀 *[نجاح مسار Graph]* تمت الموافقة وأرسل الوكيل التنبيه عبر بروتوكول MCP بنجاح: '{st.session_state.pending_alert}'"
                st.session_state.messages.append({"role": "assistant", "content": success_msg})
                st.session_state.pending_alert = None
                st.rerun()
                
        with col2:
            if st.button("❌ رفض وحظر المسار", use_container_width=True):
                deny_msg = "🛑 *[قطع مسار Graph]* تم إنهاء المخطط وحظر الإرسال بناءً على رغبة المستخدم البشرية."
                st.session_state.messages.append({"role": "assistant", "content": deny_msg})
                st.session_state.pending_alert = None
                st.rerun()